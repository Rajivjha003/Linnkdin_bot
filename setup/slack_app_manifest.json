{
  "display_information": {
    "name": "Job Agent",
    "description": "LinkedIn Easy Apply agent - review queue and controls",
    "background_color": "#1a1d21"
  },
  "features": {
    "bot_user": {
      "display_name": "Job Agent",
      "always_online": false
    },
    "slash_commands": [
      {
        "command": "/job_status",
        "description": "Applications in last 24h, cap remaining, pause state",
        "should_escape": false
      },
      {
        "command": "/job_pause",
        "description": "Halt all applications immediately",
        "should_escape": false
      },
      {
        "command": "/job_resume",
        "description": "Un-halt the agent",
        "should_escape": false
      },
      {
        "command": "/job_apply_now",
        "description": "Trigger a run immediately instead of waiting for the schedule",
        "should_escape": false
      },
      {
        "command": "/job_update_cookie",
        "description": "Paste a fresh li_at cookie after an auth failure",
        "usage_hint": "<li_at value>",
        "should_escape": false
      },
      {
        "command": "/job_set_resume",
        "description": "Set which saved LinkedIn resume filename to select",
        "usage_hint": "<exact filename as shown on LinkedIn>",
        "should_escape": false
      },
      {
        "command": "/job_update_resume",
        "description": "Replace the stored resume text used for scoring",
        "should_escape": false
      },
      {
        "command": "/job_add_location",
        "description": "Add a search location",
        "usage_hint": "<location>",
        "should_escape": false
      },
      {
        "command": "/job_set_threshold",
        "description": "Set match score (0-100) or vector threshold (0-1)",
        "usage_hint": "match 70 | vector 0.85",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "chat:write",
        "commands",
        "groups:read",
        "files:write",
        "reactions:write",
        "im:write"
      ]
    }
  },
  "settings": {
    "interactivity": {
      "is_enabled": true
    },
    "socket_mode_enabled": true,
    "org_deploy_enabled": false,
    "token_rotation_enabled": false
  }
}
